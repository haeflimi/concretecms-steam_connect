msgstr "%s (Benutzer %s): Spieldetails sind privat"

#: steam_connect/src/Sync/SteamDataSync.php:94
#, php-format
msgid "%s (user %s): %s games"
msgstr "%s (Benutzer %s): %s Spiele"

#: steam_connect/src/Sync/SteamDataSync.php:100
#, php-format
msgid "%s (user %s): %s"
msgstr "%s (Benutzer %s): %s"

#: steam_connect/src/Sync/SteamClubSync.php:88
#, php-format
msgid "The Steam group has %s members."
msgstr "Die Steam-Gruppe hat %s Mitglieder."

#: steam_connect/src/Sync/SteamClubSync.php:99
#, php-format
msgid "%s of %s linked users are members of the Steam group."
msgstr "%s von %s verknüpften Benutzern sind Mitglied der Steam-Gruppe."

#: steam_connect/src/Sync/SteamClubSync.php:121
#, php-format
msgid "The Steam group has more than %s members, which is not supported."
msgstr "Die Steam-Gruppe hat mehr als %s Mitglieder, das wird nicht unterstützt."

#: steam_connect/src/Sync/SteamClubSync.php:132
#, php-format
msgid "Unable to read the members of the Steam group: %s"
msgstr "Die Mitglieder der Steam-Gruppe konnten nicht gelesen werden: %s"

#: steam_connect/src/Sync/SteamClubSync.php:138
#, php-format
msgid "The Steam group %s was not found or its member list is not public."
msgstr "Die Steam-Gruppe %s wurde nicht gefunden oder ihre Mitgliederliste ist nicht öffentlich."

#: steam_connect/src/Sync/SteamClubSync.php:170
#, php-format
msgid "Group \"%s\": %s added, %s removed."
msgstr "Benutzergruppe «%s»: %s hinzugefügt, %s entfernt."

#: steam_connect/src/Command/PruneSteamDataCommandHandler.php:23
#, php-format
msgid "Removed the data of %s unlinked Steam accounts."
msgstr "Die Daten von %s nicht mehr verknüpften Steam-Konten wurden entfernt."

#: steam_connect/src/Command/SyncSteamAchievementsCommandHandler.php:28
#, php-format
msgid "%s: achievements are up to date."
msgstr "%s: Erfolge sind aktuell."

#: steam_connect/src/Install/LegacyPackageCleanup.php:61
#, php-format
msgid "Steam Connect replaced the old package(s) %s and took over %s linked Steam accounts and the settings. The folder(s) %s can be deleted."
msgstr "Steam Connect hat das bzw. die alten Pakete %s ersetzt und %s verknüpfte Steam-Konten sowie die Einstellungen übernommen. Der bzw. die Ordner %s können gelöscht werden."

#: steam_connect/src/Command/Task/SyncSteamDataController.php:43
#: steam_connect/src/Command/Task/SyncSteamDataController.php:63
msgid "Sync Steam Data"
msgstr "Steam-Daten synchronisieren"

#: steam_connect/src/Command/Task/SyncSteamDataController.php:48
msgid "Stores the Steam profile, bans, owned games, playtime, achievements and Steam group membership of all users who linked their Steam account."
msgstr "Speichert Steam-Profil, Sperren, besessene Spiele, Spielzeit, Erfolge und Steam-Gruppenmitgliedschaft aller Benutzer, die ihr Steam-Konto verknüpft haben."

#: steam_connect/src/Command/Task/SyncSteamDataController.php:59
msgid "Please configure a Steam Web API key in the Steam authentication type first."
msgstr "Bitte konfiguriere zuerst einen Steam Web API Key im Steam-Anmeldetyp."

#: steam_connect/src/Command/Task/SyncSteamDataController.php:76
msgid "Syncing Steam data..."
msgstr "Steam-Daten werden synchronisiert …"
