msgstr "%s: %s"

#: steam_connect/src/Sync/SteamAchievementSync.php:73
#, php-format
msgid "%s: %s of %s achievements"
msgstr "%s: %s von %s Erfolgen"

#: steam_connect/src/Sync/SteamDataSync.php:93
#, php-format
