msgid_plural "%s achievements"
msgstr[0] "%s Erfolg"
msgstr[1] "%s Erfolge"

#: steam_connect/blocks/steam_leaderboard/controller.php:167
#, php-format
msgid "Since %s"
msgstr "Seit %s"

#: steam_connect/blocks/steam_leaderboard/controller.php:294
#, php-format
msgid "%s min"
msgstr "%s Min."

#: steam_connect/blocks/steam_leaderboard/controller.php:297
#, php-format
msgid "%s h"
msgstr "%s Std."

#: steam_connect/blocks/steam_leaderboard/controller.php:311
msgid "All games"
msgstr "Alle Spiele"

#: steam_connect/blocks/steam_leaderboard/controller.php:317
msgid "Achievement Leaderboard"
msgstr "Erfolgs-Rangliste"

#: steam_connect/blocks/steam_leaderboard/controller.php:318
msgid "Perfect Games (all achievements unlocked)"
msgstr "Perfekte Spiele (alle Erfolge freigeschaltet)"

#: steam_connect/blocks/steam_leaderboard/controller.php:319
msgid "Most Played Games"
msgstr "Meistgespielte Spiele"

#: steam_connect/blocks/steam_leaderboard/controller.php:320
msgid "Most Owned Games"
msgstr "Am häufigsten besessene Spiele"

#: steam_connect/blocks/steam_leaderboard/controller.php:327
msgid "All time"
msgstr "Gesamter Zeitraum"

#: steam_connect/blocks/steam_leaderboard/controller.php:328
msgid "Last 2 weeks"
msgstr "Letzte 2 Wochen"

#: steam_connect/blocks/steam_leaderboard/controller.php:329
msgid "Last 30 days"
msgstr "Letzte 30 Tage"

#: steam_connect/blocks/steam_leaderboard/controller.php:330
msgid "Last 90 days"
msgstr "Letzte 90 Tage"

#: steam_connect/blocks/steam_leaderboard/controller.php:331
msgid "Last 12 months"
msgstr "Letzte 12 Monate"

#: steam_connect/blocks/steam_leaderboard/controller.php:332
msgid "Since a date"
msgstr "Seit einem Datum"

#: steam_connect/blocks/steam_leaderboard/form.php:19
msgid "Leaderboard"
msgstr "Rangliste"

#: steam_connect/blocks/steam_leaderboard/form.php:23
msgid "Title"
msgstr "Titel"

#: steam_connect/blocks/steam_leaderboard/form.php:24
msgid "Name of the leaderboard"
msgstr "Name der Rangliste"

#: steam_connect/blocks/steam_leaderboard/form.php:27
msgid "Game"
msgstr "Spiel"

#: steam_connect/blocks/steam_leaderboard/form.php:29
msgid "Only games in which somebody unlocked an achievement are listed."
msgstr "Es werden nur Spiele aufgeführt, in denen jemand einen Erfolg freigeschaltet hat."

#: steam_connect/blocks/steam_leaderboard/form.php:32
msgid "Period"
msgstr "Zeitraum"

#: steam_connect/blocks/steam_leaderboard/form.php:34
msgid "Playtime of other periods than \"All time\" and \"Last 2 weeks\" is calculated from the data collected by the Sync Steam Data task, so it only covers the time since its first run."
msgstr "Die Spielzeit anderer Zeiträume als «Gesamter Zeitraum» und «Letzte 2 Wochen» wird aus den Daten berechnet, die die Aufgabe «Steam-Daten synchronisieren» sammelt; sie deckt also nur die Zeit seit ihrer ersten Ausführung ab."

#: steam_connect/blocks/steam_leaderboard/form.php:37
msgid "Start date"
msgstr "Startdatum"

#: steam_connect/blocks/steam_leaderboard/form.php:39
msgid "E.g. the first day of a LAN party."
msgstr "Z. B. der erste Tag einer LAN-Party."

#: steam_connect/blocks/steam_leaderboard/form.php:42
msgid "Number of entries"
msgstr "Anzahl Einträge"

#: steam_connect/blocks/steam_leaderboard/view.php:24
msgid "No data yet."
msgstr "Noch keine Daten."

